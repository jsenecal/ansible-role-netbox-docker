####
## This file contains extra configuration options that can't be configured
## directly through environment variables.
####

import logging
import sys

from os import environ

if environ.get('DEBUG', 'False').lower() == 'true':
    root = logging.getLogger()
    root.setLevel(logging.DEBUG)

    handler = logging.StreamHandler(sys.stdout)
    handler.setLevel(logging.DEBUG)
    formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')
    handler.setFormatter(formatter)
    root.addHandler(handler)

ADMINS = [
{% for admin in netbox_admins %}
    ["{{admin.name}}", "{{admin.email}}"],
{% endfor %}
]

{% if netbox_db_engine %}
# netbox-docker loads each config file as its own isolated module under
# /etc/netbox/config/ and merges them via a module-level __getattr__ in the
# parent `netbox.configuration` namespace. That means names defined in
# configuration.py aren't in scope here. Import DATABASES by reference (dicts
# are shared) and mutate the ENGINE key in place — the change is visible to
# the configuration.py module the rest of NetBox reads from.
from netbox.configuration.configuration import DATABASES as _DATABASES
_DATABASES["default"]["ENGINE"] = "{{ netbox_db_engine }}"
{% endif %}
{{ netbox_extra_config }}
